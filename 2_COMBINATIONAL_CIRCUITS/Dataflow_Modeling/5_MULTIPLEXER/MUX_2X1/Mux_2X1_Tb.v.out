#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_011D8888 .scope module, "Mux_2X1_Tb" "Mux_2X1_Tb" 2 4;
 .timescale -9 -12;
v011D8AF0_0 .var "I0", 0 0;
v011D8B48_0 .var "I1", 0 0;
v011D8BA0_0 .var "S", 0 0;
v011DE380_0 .net "Y", 0 0, L_011DE668; 1 drivers
S_011D1610 .scope module, "uut" "Mux_2X1" 2 9, 3 1, S_011D8888;
 .timescale -9 -12;
L_011D8BF8 .functor NOT 1, v011D8BA0_0, C4<0>, C4<0>, C4<0>;
L_011DE410 .functor AND 1, v011D8AF0_0, L_011D8BF8, C4<1>, C4<1>;
L_011DE630 .functor AND 1, v011D8B48_0, v011D8BA0_0, C4<1>, C4<1>;
L_011DE668 .functor OR 1, L_011DE410, L_011DE630, C4<0>, C4<0>;
v011D1698_0 .net "I0", 0 0, v011D8AF0_0; 1 drivers
v011D16F0_0 .net "I1", 0 0, v011D8B48_0; 1 drivers
v011D3BF8_0 .net "S", 0 0, v011D8BA0_0; 1 drivers
v011D3C50_0 .alias "Y", 0 0, v011DE380_0;
v011D3CA8_0 .net *"_s0", 0 0, L_011D8BF8; 1 drivers
v011D3D00_0 .net *"_s2", 0 0, L_011DE410; 1 drivers
v011D8A98_0 .net *"_s4", 0 0, L_011DE630; 1 drivers
    .scope S_011D8888;
T_0 ;
    %vpi_call 2 12 "$dumpfile", "Mux_2X1.vcd";
    %vpi_call 2 13 "$dumpvars", 1'sb0, S_011D8888;
    %end;
    .thread T_0;
    .scope S_011D8888;
T_1 ;
    %vpi_call 2 18 "$display", "-------------";
    %vpi_call 2 19 "$display", "I0| I1| S | Y";
    %vpi_call 2 20 "$display", "-------------";
    %vpi_call 2 21 "$monitor", "%b | %b | %b | %b", v011D8AF0_0, v011D8B48_0, v011D8BA0_0, v011DE380_0;
    %set/v v011D8AF0_0, 0, 1;
    %set/v v011D8B48_0, 0, 1;
    %set/v v011D8BA0_0, 0, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 0, 1;
    %set/v v011D8B48_0, 1, 1;
    %set/v v011D8BA0_0, 0, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 1, 1;
    %set/v v011D8B48_0, 0, 1;
    %set/v v011D8BA0_0, 0, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 1, 1;
    %set/v v011D8B48_0, 1, 1;
    %set/v v011D8BA0_0, 0, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 0, 1;
    %set/v v011D8B48_0, 0, 1;
    %set/v v011D8BA0_0, 1, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 0, 1;
    %set/v v011D8B48_0, 1, 1;
    %set/v v011D8BA0_0, 1, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 1, 1;
    %set/v v011D8B48_0, 0, 1;
    %set/v v011D8BA0_0, 1, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 1, 1;
    %set/v v011D8B48_0, 1, 1;
    %set/v v011D8BA0_0, 1, 1;
    %delay 10000, 0;
    %vpi_call 2 31 "$display", "-------------";
    %set/v v011D8AF0_0, 2, 1;
    %set/v v011D8B48_0, 3, 1;
    %set/v v011D8BA0_0, 1, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 2, 1;
    %set/v v011D8B48_0, 3, 1;
    %set/v v011D8BA0_0, 0, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 1, 1;
    %set/v v011D8B48_0, 0, 1;
    %set/v v011D8BA0_0, 3, 1;
    %delay 10000, 0;
    %set/v v011D8AF0_0, 1, 1;
    %set/v v011D8B48_0, 0, 1;
    %set/v v011D8BA0_0, 2, 1;
    %delay 10000, 0;
    %vpi_call 2 36 "$display", "-------------";
    %vpi_call 2 37 "$finish";
